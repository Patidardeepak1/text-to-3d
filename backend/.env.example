# Server
PORT=4000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
# Use the deployed frontend origin in production, for example:
# https://3dforge.vercel.app
CORS_ORIGIN=http://localhost:5173

# Public base URL of this API. Leave empty to derive it from the incoming request.
# Set this on Render/Railway if you want absolute URLs in responses.
# PUBLIC_BASE_URL=https://your-api.onrender.com

# tripo = Tripo OpenAPI text-to-3D (https://openapi.tripo3d.ai/v3)
# fal = text-to-3D through fal.ai
# demo = local sample GLB labeled as a development model, never presented as AI
AI_PROVIDER=tripo

# Required when AI_PROVIDER=tripo. Create a key in the Tripo console.
# https://platform.tripo3d.ai
TRIPO_API_KEY=
TRIPO_MODEL=v3.1-20260211

# Required when AI_PROVIDER=fal. Create a key at https://fal.ai/dashboard/keys
FAL_KEY=

# Text-to-3D model on fal. Tripo H3.1 returns a GLB and supports queue + cancel.
FAL_MODEL_ID=tripo3d/h3.1/text-to-3d

# Optional JSON object merged into the provider request body.
# Example for a geometry-only Hunyuan run:
# FAL_INPUT_JSON={"generate_type":"Geometry"}
FAL_INPUT_JSON=

# How long a development demo waits before the sample model is ready.
DEMO_DELAY_MS=800

# Generation POST rate limit per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=8

# Directory for generated models. Ephemeral on most free hosts.
STORAGE_DIR=data
